{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../.",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "toc.yml",
          "index.md",
          "docs/**/*.md",
          "docs/**/*.yml",
          "api/**.yml",
          "api/index.md"
        ],
        "exclude": ["_site/**", "docs/old/**"]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Distributed World Evolution",
      "_appTitle": "Distributed World Evolution",
      "_enableSearch": true,
      "pdf": true
    }
  }
}